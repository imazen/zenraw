# RAW/DNG/TIFF dictionary
# TIFF little-endian header
"\x49\x49\x2a\x00"
# TIFF big-endian header
"\x4d\x4d\x00\x2a"
# DNG version tag
"\x12\xc6"
# Apple APPLEDNG signature
"APPLEDNG"
# Canon CR3
"ftypcrx "
# Fujifilm RAF
"FUJIFILMCCD-RAW"
# JPEG SOI
"\xff\xd8"
# AMPF marker
"AMPF"
# Common TIFF IFD tags
tiff_imagewidth="\x00\x01"
tiff_imagelength="\x01\x01"
tiff_compression="\x03\x01"
tiff_stripoffsets="\x11\x01"
tiff_stripbytecounts="\x17\x01"
